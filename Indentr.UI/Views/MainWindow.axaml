<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Indentr.UI.Controls"
        x:Class="Indentr.UI.Views.MainWindow"
             Icon="avares://Indentr.UI/Assets/icon.png"
        Title="Indentr"
        Width="1200" Height="760"
        WindowStartupLocation="CenterScreen"
        KeyDown="OnKeyDown">

    <DockPanel>
        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Search…"          Click="OnSearchClicked" />
                <MenuItem Header="S_cratchpad"       Click="OnScratchpadClicked" />
                <MenuItem Header="_Manage Notes…"    Click="OnManageClicked" />
                <MenuItem Header="_Trash…"           Click="OnTrashClicked" />
                <MenuItem Header="_Import…"           Click="OnImportClicked" />
                <MenuItem Header="Recover Kanban Notes…" Click="OnKanbanRecoveryClicked" />
                <MenuItem Header="_Export">
                    <MenuItem Header="Export _Single Note" Click="OnExportSingleNoteClicked" />
                    <MenuItem Header="Export _Subtree"     Click="OnExportSubtreeClicked" />
                </MenuItem>
                <MenuItem Header="Backup _Database…" Click="OnBackupClicked" />
                <Separator />
                <MenuItem Header="Switch _Profile…"  Click="OnManageProfilesClicked" />
                <Separator />
                <MenuItem Header="E_xit"             Click="OnExitClicked" />
            </MenuItem>
        </Menu>

        <!-- Sync status bar — hidden when no remote is configured -->
        <Border DockPanel.Dock="Bottom"
                x:Name="SyncBar"
                IsVisible="False"
                BorderThickness="0,1,0,0"
                Padding="8,3">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           x:Name="SyncStatusText"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Opacity="0.75" />
                <Button Grid.Column="1"
                        x:Name="SyncNowButton"
                        Content="Sync now"
                        FontSize="12"
                        Padding="8,2"
                        Click="OnSyncNowClicked" />
            </Grid>
        </Border>

        <!-- Quick-access toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="4,4,4,0">
            <Button Content="🔍 Search" Click="OnSearchClicked" ToolTip.Tip="Search notes (File → Search…)" />
        </StackPanel>

        <controls:NoteEditorControl x:Name="RootEditor" />
    </DockPanel>
</Window>
