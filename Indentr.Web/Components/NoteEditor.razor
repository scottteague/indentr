@inject AppSession Session
@inject NoteChangeNotifier Notifier
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IAsyncDisposable

@if (_note is not null)
{
    <div class="note-editor">
        <div class="note-header">
            @if (_note.IsRoot)
            {
                <h1 class="note-title">@_note.Title</h1>
            }
            else
            {
                <input class="note-title-input"
                       value="@_currentTitle"
                       @oninput="OnTitleInput"
                       @onblur="OnTitleBlur"
                       @onkeydown="OnTitleKeyDown" />
            }
            <div class="note-actions">
                @if (_saving)
                {
                    <span class="status-text">Saving…</span>
                }
                else if (_conflictMessage is not null)
                {
                    <span class="status-conflict">@_conflictMessage</span>
                }
                @if (!_note.IsRoot)
                {
                    <label class="privacy-toggle" title="When checked, only you can see this note">
                        <input type="checkbox"
                               checked="@_note.IsPrivate"
                               disabled="@(_note.CreatedBy != Session.CurrentUser!.Id)"
                               @onchange="OnPrivacyChanged" />
                        Private
                    </label>
                    <button class="btn-trash" @onclick="MoveToTrashAsync"
                            disabled="@(_saving || _deleting)">Move to Trash</button>
                }
                <button class="btn-save" @onclick="SaveAsync" disabled="@(_saving || _deleting)">Save</button>
            </div>
        </div>

        <div class="format-toolbar">
            <button class="fmt-btn fmt-bold"      title="Bold (**text**)"      disabled="@(!_editorInitialized)" @onclick='() => WrapSelectionAsync("**", "**")'>B</button>
            <button class="fmt-btn fmt-red"       title="Red (__text__)"       disabled="@(!_editorInitialized)" @onclick='() => WrapSelectionAsync("__", "__")'>R</button>
            <button class="fmt-btn fmt-italic"    title="Italic (*text*)"      disabled="@(!_editorInitialized)" @onclick='() => WrapSelectionAsync("*", "*")'>I</button>
            <button class="fmt-btn fmt-underline" title="Underline (_text_)"   disabled="@(!_editorInitialized)" @onclick='() => WrapSelectionAsync("_", "_")'>U</button>
            <span class="fmt-sep"></span>
            <button class="fmt-btn fmt-wide" title="Insert a link to an existing note" disabled="@(!_editorInitialized)" @onclick="OpenLinkModal">Link</button>
            <button class="fmt-btn fmt-wide" title="Create a new child note and insert a link" disabled="@(!_editorInitialized)" @onclick="OnNewChildNoteAsync">+ Note</button>
            @if (!_note.IsRoot)
            {
                <button class="fmt-btn fmt-wide" title="Create a new Kanban board and insert a link" disabled="@(!_editorInitialized)" @onclick="OnNewBoardAsync">+ Board</button>
            }
            <span class="fmt-sep"></span>
            <button class="fmt-btn fmt-wide" title="Export note as a Markdown file" disabled="@(!_editorInitialized)" @onclick="OnExportAsync">Export</button>
            <button class="fmt-btn fmt-wide" title="Export this note and all its descendants as a .zip archive" disabled="@(!_editorInitialized)" @onclick="OnExportSubtreeAsync">Export Tree</button>
        </div>

        <div class="attachments">
            <strong>Attachments:</strong>
            @foreach (var att in _attachments)
            {
                <span class="attachment-item">
                    <a href="/api/attachments/@att.Id" target="_blank" class="attachment-link">@att.Filename</a>
                    <button class="att-del-btn" @onclick="() => DeleteAttachmentAsync(att)" title="Delete attachment">×</button>
                </span>
            }
            <label class="att-upload-label" title="Attach files">
                <InputFile OnChange="OnFilesSelectedAsync" multiple class="att-upload-input" />
                📎 Attach
            </label>
            @if (_uploading) { <span class="status-text">Uploading…</span> }
        </div>

        <div id="@_editorId" class="cm-host"></div>

        @if (_linkModalOpen)
        {
            <div class="modal-overlay" @onclick="CloseLinkModal">
                <div class="link-modal" @onclick:stopPropagation>
                    <div class="link-modal-title">Insert Note Link</div>
                    <input class="link-search-input"
                           placeholder="Search notes…"
                           value="@_linkSearch"
                           @oninput="OnLinkSearchInput"
                           @onkeydown="OnLinkSearchKeyDown"
                           @ref="_linkSearchRef" />
                    <div class="link-results">
                        @if (!_linkResults.Any())
                        {
                            <div class="link-empty">@(string.IsNullOrWhiteSpace(_linkSearch) ? "Type to search notes…" : "No results")</div>
                        }
                        else
                        {
                            @foreach (var n in _linkResults)
                            {
                                <button class="link-result" @onclick="() => InsertLinkAsync(n)">@n.Title</button>
                            }
                        }
                    </div>
                    <div class="link-modal-footer">
                        <button class="link-cancel-btn" @onclick="CloseLinkModal">Cancel</button>
                    </div>
                </div>
            </div>
        }
    </div>
}
else if (_notFound)
{
    <div class="note-missing">Note not found.</div>
}
else
{
    <div class="note-missing">Loading…</div>
}

@code {
    [Parameter, EditorRequired] public Guid NoteId { get; set; }

    private Note?   _note;
    private bool    _notFound;
    private bool    _saving;
    private bool    _deleting;
    private bool    _isDirty;
    private bool    _titleDirty;
    private string? _conflictMessage;
    private string  _currentContent = "";
    private string  _currentTitle   = "";
    private string  _editorId = "";
    private IReadOnlyList<AttachmentMeta> _attachments = [];
    private bool _uploading;
    private CancellationTokenSource? _saveCts;

    private IJSObjectReference?         _module;
    private DotNetObjectReference<NoteEditor>? _dotNetRef;
    private bool _editorInitialized;

    // Link insertion modal
    private bool                 _linkModalOpen;
    private string               _linkSearch    = "";
    private IEnumerable<Note>    _linkResults   = [];
    private CancellationTokenSource? _linkSearchCts;
    private bool                 _focusLinkSearch;
    private ElementReference     _linkSearchRef;

    protected override async Task OnInitializedAsync()
    {
        _editorId = $"cm-{NoteId:N}";
        Notifier.NoteChanged += HandleChange;
        await LoadNoteAsync();
    }

    private async Task LoadNoteAsync()
    {
        if (Session.Notes is null || Session.Attachments is null || Session.CurrentUser is null) return;

        var note = await Session.Notes.GetByIdAsync(NoteId);
        if (note is null) { _notFound = true; return; }

        // Privacy guard
        if (note.IsPrivate && note.CreatedBy != Session.CurrentUser.Id)
        {
            Nav.NavigateTo("/");
            return;
        }

        _note = note;
        _currentContent = note.Content;
        _currentTitle   = note.Title;
        _attachments = await Session.Attachments.ListForNoteAsync(NoteId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusLinkSearch)
        {
            _focusLinkSearch = false;
            try { await _linkSearchRef.FocusAsync(); } catch { }
        }

        if (_editorInitialized || _note is null) return;
        _editorInitialized = true; // guard before first await to prevent double-init

        _module     = await JS.InvokeAsync<IJSObjectReference>("import", "/js/editor.js");
        _dotNetRef  = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("create", _editorId, _note.Content, _dotNetRef);
    }

    [JSInvokable]
    public void OnContentChanged(string content)
    {
        _currentContent = content;
        _isDirty = true;

        // Debounce: cancel any pending auto-save and schedule a new one.
        _saveCts?.Cancel();
        _saveCts?.Dispose();
        _saveCts = new CancellationTokenSource();
        var token = _saveCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(3000, token);
                await InvokeAsync(SaveAsync);
            }
            catch (OperationCanceledException) { }
        });
    }

    [JSInvokable]
    public Task SaveFromKeyboard() => SaveAsync();

    [JSInvokable]
    public void OnLinkClicked(string target)
    {
        if (target.StartsWith("note:") && Guid.TryParse(target[5..], out var id))
            _ = JS.InvokeVoidAsync("open", $"/note/{id}", "_blank");
        else if (target.StartsWith("kanban:") && Guid.TryParse(target[7..], out var bid))
            Nav.NavigateTo($"/board/{bid}");
        else if (!target.StartsWith("kanban:"))
            _ = JS.InvokeVoidAsync("open", target, "_blank");
    }

    private async Task OnNewBoardAsync()
    {
        if (_module is null || Session.Kanban is null || Session.CurrentUser is null) return;

        var title = await _module.InvokeAsync<string>("getSelection", _editorId);
        title = title.Trim();
        if (string.IsNullOrEmpty(title))
        {
            title = await JS.InvokeAsync<string>("prompt", "Board title:") ?? "";
            title = title.Trim();
        }
        if (string.IsNullOrEmpty(title)) return;

        var board = await Session.Kanban.CreateBoardAsync(title, Session.CurrentUser.Id);
        await _module.InvokeVoidAsync("replaceSelection", _editorId, $"[{title}](kanban:{board.Id})");
    }

    private async Task WrapSelectionAsync(string before, string after)
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("wrapSelection", _editorId, before, after);
    }

    private async Task OnPrivacyChanged(ChangeEventArgs e)
    {
        if (_note is null) return;
        _note.IsPrivate = (bool?)e.Value ?? false;
        await SaveAsync();
    }

    private async Task MoveToTrashAsync()
    {
        if (_note is null || Session.Notes is null) return;
        var ok = await JS.InvokeAsync<bool>("confirm", $"Move \"{_note.Title}\" to Trash?");
        if (!ok) return;

        _deleting = true;
        StateHasChanged();
        try
        {
            await Session.Notes.DeleteAsync(NoteId);
            Notifier.NotifyChanged(NoteId);
            Nav.NavigateTo("/");
        }
        finally
        {
            _deleting = false;
        }
    }

    private void OnTitleInput(ChangeEventArgs e)
    {
        _currentTitle = e.Value?.ToString() ?? "";
        _titleDirty   = _currentTitle != _note!.Title;
    }

    private async Task OnTitleBlur()
    {
        if (_titleDirty) await SaveTitleAsync();
    }

    private async Task OnTitleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SaveTitleAsync();
    }

    private async Task SaveTitleAsync()
    {
        if (_note is null || !_titleDirty) return;
        var trimmed = _currentTitle.Trim();
        if (string.IsNullOrEmpty(trimmed))
        {
            // Revert to the last saved title.
            _currentTitle = _note.Title;
            _titleDirty   = false;
            StateHasChanged();
            return;
        }
        _titleDirty   = false;
        _note.Title   = trimmed;
        _currentTitle = trimmed;
        await SaveAsync();
    }

    private async Task SaveAsync()
    {
        if (_note is null || Session.Notes is null) return;
        _saving = true;
        _conflictMessage = null;
        StateHasChanged();

        try
        {
            _currentContent = await _module!.InvokeAsync<string>("getContent", _editorId);
            _note.Content = _currentContent;
            _isDirty = false;

            var originalHash = _note.ContentHash;
            var result = await Session.Notes.SaveAsync(_note, originalHash);

            if (result == SaveResult.Conflict)
            {
                _conflictMessage = "Conflict detected — a [CONFLICT] note was created. Reloading…";
                // Reload to get the server's version
                var fresh = await Session.Notes.GetByIdAsync(NoteId);
                if (fresh is not null)
                {
                    _note = fresh;
                    await _module!.InvokeVoidAsync("setContent", _editorId, _note.Content);
                }
            }
            else
            {
                // Reload to get updated hash
                var fresh = await Session.Notes.GetByIdAsync(NoteId);
                if (fresh is not null) _note = fresh;
            }

            var affected = await Session.Notes.UpdateLinkTitlesAsync(NoteId, _note.Title);
            Notifier.NotifyChanged(NoteId);
            foreach (var id in affected) Notifier.NotifyChanged(id);
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private async Task OnFilesSelectedAsync(InputFileChangeEventArgs e)
    {
        if (Session.Attachments is null) return;
        _uploading = true;
        StateHasChanged();
        try
        {
            foreach (var file in e.GetMultipleFiles(10))
            {
                await using var stream = file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
                var mime = string.IsNullOrEmpty(file.ContentType) ? "application/octet-stream" : file.ContentType;
                var meta = await Session.Attachments.StoreAsync(NoteId, file.Name, mime, stream);
                _attachments = _attachments.Append(meta).ToList();
            }
        }
        finally
        {
            _uploading = false;
            StateHasChanged();
        }
    }

    private async Task DeleteAttachmentAsync(AttachmentMeta att)
    {
        if (Session.Attachments is null) return;
        var ok = await JS.InvokeAsync<bool>("confirm", $"Delete attachment \"{att.Filename}\"?");
        if (!ok) return;
        await Session.Attachments.DeleteAsync(att.Id);
        _attachments = _attachments.Where(a => a.Id != att.Id).ToList();
        StateHasChanged();
    }

    private async Task OnExportAsync()
    {
        if (_module is null || _note is null) return;
        var content = await _module.InvokeAsync<string>("getContent", _editorId);
        var exported = System.Text.RegularExpressions.Regex.Replace(
            content,
            @"\[([^\]]*)\]\((note|kanban):[^\)]*\)",
            "$1");
        var safeName = string.Concat(_note.Title.Where(c => !Path.GetInvalidFileNameChars().Contains(c)));
        if (string.IsNullOrWhiteSpace(safeName)) safeName = "note";
        await _module.InvokeVoidAsync("downloadFile", safeName + ".md", exported);
    }

    private async Task OnExportSubtreeAsync()
    {
        await JS.InvokeVoidAsync("open", $"/api/export/{NoteId}", "_blank");
    }

    private async Task OnNewChildNoteAsync()
    {
        if (_module is null || Session.Notes is null || Session.CurrentUser is null) return;
        var title = await _module.InvokeAsync<string>("getSelection", _editorId);
        title = title.Trim();
        if (string.IsNullOrEmpty(title))
        {
            title = await JS.InvokeAsync<string>("prompt", "New note title:") ?? "";
            title = title.Trim();
        }
        if (string.IsNullOrEmpty(title)) return;
        var note = await Session.Notes.CreateAsync(new Note
        {
            Title     = title,
            OwnerId   = Session.CurrentUser.Id,
            CreatedBy = Session.CurrentUser.Id,
        });
        await _module.InvokeVoidAsync("replaceSelection", _editorId, $"[{title}](note:{note.Id})");
    }

    private void OpenLinkModal()
    {
        _linkSearch    = "";
        _linkResults   = [];
        _linkModalOpen = true;
        _focusLinkSearch = true;
    }

    private void CloseLinkModal()
    {
        _linkModalOpen = false;
        _linkSearchCts?.Cancel();
        _linkSearchCts?.Dispose();
        _linkSearchCts = null;
    }

    private async Task OnLinkSearchInput(ChangeEventArgs e)
    {
        _linkSearch = e.Value?.ToString() ?? "";
        _linkSearchCts?.Cancel();
        _linkSearchCts?.Dispose();
        _linkSearchCts = null;

        if (string.IsNullOrWhiteSpace(_linkSearch))
        {
            _linkResults = [];
            return;
        }

        _linkSearchCts = new CancellationTokenSource();
        var token = _linkSearchCts.Token;
        try
        {
            await Task.Delay(200, token);
            _linkResults = await Session.Notes!.SearchAsync(_linkSearch, Session.CurrentUser!.Id);
            StateHasChanged();
        }
        catch (OperationCanceledException) { }
    }

    private void OnLinkSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseLinkModal();
    }

    private async Task InsertLinkAsync(Note note)
    {
        if (_module is null) return;
        CloseLinkModal();
        await _module.InvokeVoidAsync("replaceSelection", _editorId, $"[{note.Title}](note:{note.Id})");
    }

    private void HandleChange(Guid id)
    {
        if (id != NoteId) return;
        _ = InvokeAsync(async () =>
        {
            await ReloadContentAsync();
            StateHasChanged();
        });
    }

    private async Task ReloadContentAsync()
    {
        if (Session.Notes is null) return;
        var fresh = await Session.Notes.GetByIdAsync(NoteId);
        if (fresh is null || _module is null) return;

        var prevHash = _note?.ContentHash;
        _note = fresh;
        if (!_titleDirty) _currentTitle = fresh.Title;
        // Only push content to the editor if it changed externally — skipping our own saves.
        if (fresh.ContentHash != prevHash)
            await _module.InvokeVoidAsync("setContent", _editorId, _note.Content);
    }

    public async ValueTask DisposeAsync()
    {
        Notifier.NoteChanged -= HandleChange;

        _linkSearchCts?.Cancel();
        _linkSearchCts?.Dispose();

        // Cancel pending debounced save, then do a final quiet save if there are
        // unsaved edits. _currentContent is already current server-side (kept up to
        // date by OnContentChanged), so no JS interop is needed here.
        _saveCts?.Cancel();
        _saveCts?.Dispose();
        if (_isDirty && _note is not null && Session.Notes is not null)
        {
            try
            {
                _note.Content = _currentContent;
                await Session.Notes.SaveAsync(_note, _note.ContentHash);
            }
            catch { }
        }

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("destroy", _editorId);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }

        _dotNetRef?.Dispose();
    }
}
