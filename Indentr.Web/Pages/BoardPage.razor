@page "/board/{Id:guid}"
@inject AppSession Session
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@(_board?.Title ?? "Board") — Indentr</PageTitle>

@if (_notFound)
{
    <div class="board-status">Board not found.</div>
}
else if (_board is null)
{
    <div class="board-status">Loading…</div>
}
else
{
    <div class="board-page" id="@_boardId" @onkeydown="OnKeyDown" tabindex="-1" @ref="_boardEl">
        <div class="board-header">
            @if (_editingTitle)
            {
                <input class="board-title-input" value="@_editTitleValue"
                       @oninput="e => _editTitleValue = e.Value?.ToString() ?? string.Empty"
                       @onblur="SaveBoardTitleAsync"
                       @onkeydown="OnBoardTitleKeyDown"
                       @ref="_titleInputRef" />
            }
            else
            {
                <h1 class="board-title" @onclick="StartEditBoardTitle">@_board.Title</h1>
            }
        </div>

        <div class="board-columns">
            @for (int ci = 0; ci < _columns.Count; ci++)
            {
                var col  = _columns[ci];
                var colI = ci;
                <div class="board-column" @key="col.Id">
                    <div class="column-header">
                        @if (_editingColId == col.Id)
                        {
                            <input class="column-title-input" value="@_editColTitle"
                                   @oninput="e => _editColTitle = e.Value?.ToString() ?? string.Empty"
                                   @onblur="() => SaveColumnTitleAsync(col)"
                                   @onkeydown="e => OnColumnTitleKeyDown(e, col)"
                                   @ref="_colInputRef" />
                        }
                        else
                        {
                            <span class="column-title" @onclick="() => StartEditColumnTitle(col)">@col.Title</span>
                        }
                        <button class="col-del-btn" @onclick="() => DeleteColumnAsync(col)" title="Delete column">×</button>
                    </div>

                    <div class="column-cards">
                        @for (int ki = 0; ki < col.Cards.Count; ki++)
                        {
                            var card     = col.Cards[ki];
                            var cardI    = ki;
                            var selected = _selColIdx == colI && _selCardIdx == cardI;
                            <div class="board-card @(selected ? "selected" : "")"
                                 @key="card.Id"
                                 @onclick="() => { _selColIdx = colI; _selCardIdx = cardI; }">
                                @if (_editingCardId == card.Id)
                                {
                                    <input class="card-title-input" value="@_editCardTitle"
                                           @oninput="e => _editCardTitle = e.Value?.ToString() ?? string.Empty"
                                           @onblur="() => SaveCardTitleAsync(card)"
                                           @onkeydown="e => OnCardTitleKeyDown(e, card)"
                                           @ref="_cardInputRef" />
                                }
                                else
                                {
                                    <span class="card-title" @ondblclick="() => StartEditCard(card)">@card.Title</span>
                                    <button class="card-del-btn" @onclick:stopPropagation="true"
                                            @onclick="() => DeleteCardAsync(card, col)" title="Delete">×</button>
                                }
                            </div>
                        }
                    </div>

                    <button class="add-card-btn" @onclick="() => AddCardAsync(col)">+ Add card</button>
                </div>
            }

            <div class="add-col-slot">
                @if (_addingColumn)
                {
                    <input class="new-col-input" value="@_newColumnTitle"
                           @oninput="e => _newColumnTitle = e.Value?.ToString() ?? string.Empty"
                           @onblur="ConfirmAddColumnAsync"
                           @onkeydown="OnNewColumnKeyDown"
                           placeholder="Column title…"
                           @ref="_newColInputRef" />
                }
                else
                {
                    <button class="add-col-btn" @onclick="StartAddColumn">+ Add column</button>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private KanbanBoard?       _board;
    private List<KanbanColumn> _columns = new();
    private bool               _notFound;
    private string             _boardId = "";

    // Selection
    private int _selColIdx  = -1;
    private int _selCardIdx = -1;

    // Inline editing
    private bool   _editingTitle;
    private string _editTitleValue = "";
    private Guid?  _editingColId;
    private string _editColTitle   = "";
    private Guid?  _editingCardId;
    private string _editCardTitle  = "";

    // Add column
    private bool   _addingColumn;
    private string _newColumnTitle = "";

    // Element refs
    private ElementReference _boardEl;
    private ElementReference _titleInputRef;
    private ElementReference _colInputRef;
    private ElementReference _cardInputRef;
    private ElementReference _newColInputRef;

    // Deferred focus flags
    private bool _focusTitle;
    private bool _focusColInput;
    private bool _focusCardInput;
    private bool _focusNewCol;
    private bool _focusBoard;

    private IJSObjectReference? _boardModule;

    protected override async Task OnInitializedAsync()
    {
        _boardId = $"board-{Id:N}";
        if (Session.Kanban is null) return;
        _board = await Session.Kanban.GetBoardAsync(Id);
        if (_board is null) { _notFound = true; return; }
        _columns = await Session.Kanban.GetColumnsWithCardsAsync(Id);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _board is not null)
        {
            _boardModule = await JS.InvokeAsync<IJSObjectReference>("import", "/js/board.js");
            await _boardModule.InvokeVoidAsync("init", _boardId);
        }
        if (_focusTitle)    { _focusTitle    = false; await _titleInputRef.FocusAsync(); }
        if (_focusColInput) { _focusColInput = false; await _colInputRef.FocusAsync();   }
        if (_focusCardInput){ _focusCardInput= false; await _cardInputRef.FocusAsync();  }
        if (_focusNewCol)   { _focusNewCol   = false; await _newColInputRef.FocusAsync();}
        if (_focusBoard)    { _focusBoard    = false; await _boardEl.FocusAsync();       }
    }

    // ── Board title ──────────────────────────────────────────────────────────

    private void StartEditBoardTitle()
    {
        _editTitleValue = _board!.Title;
        _editingTitle   = true;
        _focusTitle     = true;
    }

    private async Task SaveBoardTitleAsync()
    {
        if (!_editingTitle) return;
        _editingTitle = false;
        var trimmed = _editTitleValue.Trim();
        if (!string.IsNullOrEmpty(trimmed) && trimmed != _board!.Title)
        {
            _board.Title = trimmed;
            await Session.Kanban!.UpdateBoardTitleAsync(Id, trimmed);
        }
    }

    private async Task OnBoardTitleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SaveBoardTitleAsync();
        else if (e.Key == "Escape") { _editingTitle = false; _focusBoard = true; }
    }

    // ── Columns ──────────────────────────────────────────────────────────────

    private void StartEditColumnTitle(KanbanColumn col)
    {
        _editColTitle  = col.Title;
        _editingColId  = col.Id;
        _focusColInput = true;
    }

    private async Task SaveColumnTitleAsync(KanbanColumn col)
    {
        if (_editingColId != col.Id) return;
        _editingColId = null;
        var trimmed = _editColTitle.Trim();
        if (!string.IsNullOrEmpty(trimmed) && trimmed != col.Title)
        {
            col.Title = trimmed;
            await Session.Kanban!.UpdateColumnTitleAsync(col.Id, trimmed);
        }
    }

    private async Task OnColumnTitleKeyDown(KeyboardEventArgs e, KanbanColumn col)
    {
        if (e.Key == "Enter") await SaveColumnTitleAsync(col);
        else if (e.Key == "Escape") { _editingColId = null; _focusBoard = true; }
    }

    private async Task DeleteColumnAsync(KanbanColumn col)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", $"Delete column \"{col.Title}\" and all its cards?");
        if (!ok) return;
        await Session.Kanban!.DeleteColumnAsync(col.Id);
        var ci = _columns.IndexOf(col);
        _columns.Remove(col);
        if (_selColIdx >= _columns.Count) _selColIdx = _columns.Count - 1;
        if (_selColIdx == ci) _selCardIdx = -1;
    }

    private void StartAddColumn()
    {
        _newColumnTitle = "";
        _addingColumn   = true;
        _focusNewCol    = true;
    }

    private async Task ConfirmAddColumnAsync()
    {
        _addingColumn = false;
        var trimmed = _newColumnTitle.Trim();
        if (string.IsNullOrEmpty(trimmed)) return;
        var col = await Session.Kanban!.AddColumnAsync(Id, trimmed);
        _columns.Add(col);
    }

    private async Task OnNewColumnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ConfirmAddColumnAsync();
        else if (e.Key == "Escape") _addingColumn = false;
    }

    // ── Cards ─────────────────────────────────────────────────────────────────

    private async Task AddCardAsync(KanbanColumn col)
    {
        var title = await JS.InvokeAsync<string?>("prompt", "Card title:") ?? "";
        title = title.Trim();
        if (string.IsNullOrEmpty(title)) return;
        var card = await Session.Kanban!.AddCardAsync(col.Id, title);
        col.Cards.Insert(0, card);
        await Session.Kanban!.RenumberColumnCardsAsync(col.Id, col.Cards.Select(c => c.Id).ToList());
        _selColIdx  = _columns.IndexOf(col);
        _selCardIdx = 0;
        _focusBoard = true;
    }

    private void StartEditCard(KanbanCard card)
    {
        _editCardTitle  = card.Title;
        _editingCardId  = card.Id;
        _focusCardInput = true;
    }

    private async Task SaveCardTitleAsync(KanbanCard card)
    {
        if (_editingCardId != card.Id) return;
        _editingCardId = null;
        var trimmed = _editCardTitle.Trim();
        if (!string.IsNullOrEmpty(trimmed) && trimmed != card.Title)
        {
            card.Title = trimmed;
            await Session.Kanban!.UpdateCardTitleAsync(card.Id, trimmed);
        }
        _focusBoard = true;
    }

    private async Task OnCardTitleKeyDown(KeyboardEventArgs e, KanbanCard card)
    {
        if (e.Key == "Enter") await SaveCardTitleAsync(card);
        else if (e.Key == "Escape") { _editingCardId = null; _focusBoard = true; }
    }

    private async Task DeleteCardAsync(KanbanCard card, KanbanColumn col)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", $"Delete card \"{card.Title}\"?");
        if (!ok) return;
        await Session.Kanban!.DeleteCardAsync(card.Id);
        var ki = col.Cards.IndexOf(card);
        col.Cards.Remove(card);
        var ci = _columns.IndexOf(col);
        if (_selColIdx == ci)
            _selCardIdx = Math.Min(_selCardIdx, col.Cards.Count - 1);
    }

    // ── Keyboard navigation ───────────────────────────────────────────────────

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (_editingCardId is not null || _editingColId is not null || _editingTitle) return;
        if (_selColIdx < 0 || _selColIdx >= _columns.Count) return;

        var col    = _columns[_selColIdx];
        var noMod  = !e.ShiftKey && !e.CtrlKey && !e.AltKey;
        var shift  =  e.ShiftKey && !e.CtrlKey && !e.AltKey;
        bool acted = true;

        if (col.Cards.Count > 0)
            _selCardIdx = Math.Clamp(_selCardIdx, 0, col.Cards.Count - 1);

        if (e.Key == "ArrowUp" && noMod && _selCardIdx > 0)
        {
            _selCardIdx--;
        }
        else if (e.Key == "ArrowDown" && noMod && _selCardIdx < col.Cards.Count - 1)
        {
            _selCardIdx++;
        }
        else if (e.Key == "ArrowLeft" && noMod && _selColIdx > 0)
        {
            int t = _selColIdx - 1;
            while (t > 0 && _columns[t].Cards.Count == 0) t--;
            if (_columns[t].Cards.Count > 0)
            {
                _selColIdx  = t;
                _selCardIdx = Math.Min(_selCardIdx, _columns[t].Cards.Count - 1);
            }
        }
        else if (e.Key == "ArrowRight" && noMod && _selColIdx < _columns.Count - 1)
        {
            int t = _selColIdx + 1;
            while (t < _columns.Count - 1 && _columns[t].Cards.Count == 0) t++;
            if (_columns[t].Cards.Count > 0)
            {
                _selColIdx  = t;
                _selCardIdx = Math.Min(_selCardIdx, _columns[t].Cards.Count - 1);
            }
        }
        else if (e.Key == "ArrowUp" && shift && _selCardIdx > 0)
        {
            (col.Cards[_selCardIdx], col.Cards[_selCardIdx - 1]) = (col.Cards[_selCardIdx - 1], col.Cards[_selCardIdx]);
            _selCardIdx--;
            await Session.Kanban!.RenumberColumnCardsAsync(col.Id, col.Cards.Select(c => c.Id).ToList());
        }
        else if (e.Key == "ArrowDown" && shift && _selCardIdx < col.Cards.Count - 1)
        {
            (col.Cards[_selCardIdx], col.Cards[_selCardIdx + 1]) = (col.Cards[_selCardIdx + 1], col.Cards[_selCardIdx]);
            _selCardIdx++;
            await Session.Kanban!.RenumberColumnCardsAsync(col.Id, col.Cards.Select(c => c.Id).ToList());
        }
        else if (e.Key == "ArrowLeft" && shift && _selColIdx > 0)
        {
            var card = col.Cards[_selCardIdx];
            var dest = _columns[_selColIdx - 1];
            await Session.Kanban!.MoveCardToColumnAsync(card.Id, dest.Id);
            col.Cards.RemoveAt(_selCardIdx);
            await Session.Kanban!.RenumberColumnCardsAsync(col.Id, col.Cards.Select(c => c.Id).ToList());
            dest.Cards.Insert(0, card);
            card.ColumnId = dest.Id;
            await Session.Kanban!.RenumberColumnCardsAsync(dest.Id, dest.Cards.Select(c => c.Id).ToList());
            _selColIdx--;
            _selCardIdx = 0;
        }
        else if (e.Key == "ArrowRight" && shift && _selColIdx < _columns.Count - 1)
        {
            var card = col.Cards[_selCardIdx];
            var dest = _columns[_selColIdx + 1];
            await Session.Kanban!.MoveCardToColumnAsync(card.Id, dest.Id);
            col.Cards.RemoveAt(_selCardIdx);
            await Session.Kanban!.RenumberColumnCardsAsync(col.Id, col.Cards.Select(c => c.Id).ToList());
            dest.Cards.Insert(0, card);
            card.ColumnId = dest.Id;
            await Session.Kanban!.RenumberColumnCardsAsync(dest.Id, dest.Cards.Select(c => c.Id).ToList());
            _selColIdx++;
            _selCardIdx = 0;
        }
        else if (e.Key == "Enter" && noMod && col.Cards.Count > 0)
        {
            StartEditCard(col.Cards[_selCardIdx]);
        }
        else
        {
            acted = false;
        }

        if (acted) StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_boardModule is not null)
        {
            try
            {
                await _boardModule.InvokeVoidAsync("cleanup", _boardId);
                await _boardModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }
    }
}
